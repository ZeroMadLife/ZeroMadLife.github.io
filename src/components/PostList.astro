---
interface PostLike {
  id: string;
  data: {
    title: string;
    description: string;
    publishDate: Date;
    category: string;
    tags: string[];
  };
}
interface Props { posts: PostLike[]; }
const { posts } = Astro.props;
const categoryLabels: Record<string, string> = { agent: 'Agent 工程', backend: '后端与系统', growth: '成长记录' };
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<div class="post-list">
  {posts.map((post) => (
    <article class="post-row" data-title={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
      <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
      <time datetime={post.data.publishDate.toISOString()}>{fmt.format(post.data.publishDate)}</time>
      <p>{post.data.description}</p>
      <div class="tags" aria-label="文章标签">
        <a class="tag" href={`/category/${post.data.category}/`}>#{categoryLabels[post.data.category]}</a>
        {post.data.tags.slice(0, 2).map((tag) => <span class="tag">#{tag}</span>)}
      </div>
    </article>
  ))}
</div>
