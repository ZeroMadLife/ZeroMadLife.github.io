---
import { siteConfig } from "../../config";
import type { FullscreenWallpaperConfig } from "../../types/config";

interface Props {
	config: FullscreenWallpaperConfig;
	className?: string;
}

const { config, className } = Astro.props;

// 获取当前设备类型的图片源
const getImageSources = async () => {
	const srcConfig = config.src;

	// API 图片逻辑
	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi?.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const text = await response.text();
			const apiImages = text.split("\n").filter((line) => line.trim());
			if (apiImages.length > 0) {
				return { desktop: apiImages, mobile: apiImages };
			}
		} catch (error) {
			console.warn("Failed to fetch images from API:", error);
		}
	}

	const toArray = (src: string | string[] | undefined): string[] =>
		Array.isArray(src) ? src : typeof src === "string" ? [src] : [];

	if (
		typeof srcConfig === "object" &&
		srcConfig !== null &&
		!Array.isArray(srcConfig)
	) {
		const desktop = toArray(srcConfig.desktop);
		const mobile = toArray(srcConfig.mobile);
		return {
			desktop: desktop.length > 0 ? desktop : mobile,
			mobile: mobile.length > 0 ? mobile : desktop,
		};
	}

	// 如果是字符串或字符串数组，同时用于桌面端和移动端
	const allImages = toArray(srcConfig as string | string[]);
	return { desktop: allImages, mobile: allImages };
};

const imageSources = await getImageSources();
const hasDesktopImages = imageSources.desktop.length > 0;
const hasMobileImages = imageSources.mobile.length > 0;

if (!hasDesktopImages && !hasMobileImages) {
	return null;
}

// 轮播配置
const isCarouselEnabled =
	config.carousel?.enable &&
	(imageSources.desktop.length > 1 || imageSources.mobile.length > 1);
const carouselInterval = config.carousel?.interval || 5;

// 样式配置
const position = config.position || "center";
const zIndex = config.zIndex || -1;
const opacity = config.opacity || 0.8;
const blurAmount = config.blur || 0;
const positionClass = (() => {
	switch (position) {
		case "top":
			return "object-top";
		case "bottom":
			return "object-bottom";
		default:
			return "object-center";
	}
})();
---

<div
	class:list={[
		"fixed inset-0 w-full h-full overflow-hidden pointer-events-none wallpaper-container",
		className
	]}
	style={`z-index: ${zIndex}; transform: translateZ(0); perspective: 1000px; opacity: var(--wallpaper-opacity, ${opacity}); filter: blur(var(--wallpaper-blur, ${blurAmount}px));`}
	data-fullscreen-wallpaper
	aria-hidden="true"
>
	<script is:inline define:vars={{ wallpaperEnabled: config.enable ?? true, overlaySwitchable: config.overlay?.switchable ?? true }}>
	(function() {
		const root = document.documentElement;
		const container = document.currentScript?.parentElement;
		if (!container) return;

		const wallpaperEnabledVal = wallpaperEnabled;
		let storedMode = null;
		try {
			storedMode = localStorage.getItem('wallpaperMode');
		} catch {}
		const mode = wallpaperEnabledVal ? (storedMode || 'banner') : 'banner';

		if (mode === 'overlay') {
			const isSw = typeof overlaySwitchable === 'object' ? overlaySwitchable : { opacity: !!overlaySwitchable, blur: !!overlaySwitchable, cardOpacity: !!overlaySwitchable };
			let overlayOpacity = null;
			let overlayBlur = null;
			let overlayCardOpacity = null;
			try {
				overlayOpacity = isSw.opacity ? localStorage.getItem('overlayOpacity') : null;
				overlayBlur = isSw.blur ? localStorage.getItem('overlayBlur') : null;
				overlayCardOpacity = isSw.cardOpacity ? localStorage.getItem('overlayCardOpacity') : null;
			} catch {}

			if (overlayOpacity) {
				container.style.setProperty('--wallpaper-opacity', overlayOpacity);
			}
			if (overlayBlur) {
				container.style.setProperty('--wallpaper-blur', overlayBlur + 'px');
			}
			if (overlayCardOpacity) {
				root.style.setProperty('--card-transparent-opacity', overlayCardOpacity);
			}
		}

		if (mode !== 'overlay') {
			root.style.removeProperty('--card-transparent-opacity');
			container.style.display = 'none';
		}
		})();
		</script>
	<div id="wallpaper-image-layer" class="relative h-full w-full"></div>
</div>

<script
	is:inline
	define:vars={{
		desktopImages: imageSources.desktop,
		mobileImages: imageSources.mobile,
		positionClass,
		carouselInterval,
		carouselEnabled: isCarouselEnabled,
	}}
>
	(function initLazyWallpaper() {
		const container = document.querySelector('[data-fullscreen-wallpaper]');
		const layer = document.getElementById('wallpaper-image-layer');
		if (!container || !layer) return;

		if (container.dataset.lazyWallpaperReady === 'true') {
			if (typeof window.__wallpaper_cleanup === 'function') return;
			delete container.dataset.lazyWallpaperReady;
		}

		if (typeof window.__wallpaper_cleanup === 'function') {
			window.__wallpaper_cleanup();
		}

		const STORAGE_KEY = 'mizuki_wallpaper_index';
		let activeImage = null;
		let pendingImage = null;
		let currentDevice = null;
		let currentIndex = 0;
		let timer = null;
		let resizeTimer = null;
		let transitionTimer = null;
		let crossfading = false;

		function readStorage(storage, key) {
			try {
				return storage.getItem(key);
			} catch {
				return null;
			}
		}

		function isOverlayMode() {
			return (readStorage(localStorage, 'wallpaperMode') || 'banner') === 'overlay';
		}

		function getSourceSet() {
			const mobile = !window.matchMedia('(min-width: 768px)').matches;
			return {
				device: mobile ? 'mobile' : 'desktop',
				images: mobile ? mobileImages : desktopImages,
			};
		}

		function createImage(src, priority) {
			const image = document.createElement('img');
			image.alt = '';
			image.className = `absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ${positionClass}`;
			image.style.transform = 'translateZ(0)';
			image.style.backfaceVisibility = 'hidden';
			image.style.willChange = 'opacity';
			image.decoding = 'async';
			image.loading = 'eager';
			image.fetchPriority = priority;
			image.src = src;
			return image;
		}

		function showImage(index, priority) {
			const { images } = getSourceSet();
			if (!images.length || pendingImage || crossfading) return;

			const safeIndex = ((index % images.length) + images.length) % images.length;
			const nextImage = createImage(images[safeIndex], priority);
			pendingImage = nextImage;
			nextImage.style.opacity = activeImage ? '0' : '1';
			layer.appendChild(nextImage);

			const reveal = () => {
				if (!isOverlayMode() || !nextImage.isConnected) {
					nextImage.remove();
					if (pendingImage === nextImage) pendingImage = null;
					return;
				}

				pendingImage = null;
				currentIndex = safeIndex;
				try {
					sessionStorage.setItem(STORAGE_KEY, String(safeIndex));
				} catch {}
				if (!activeImage) {
					activeImage = nextImage;
					return;
				}

				crossfading = true;
				const previousImage = activeImage;
				requestAnimationFrame(() => {
					requestAnimationFrame(() => {
						nextImage.style.opacity = '1';
						previousImage.style.opacity = '0';
					});
				});

				transitionTimer = setTimeout(() => {
					previousImage.remove();
					activeImage = nextImage;
					crossfading = false;
					transitionTimer = null;
				}, 1050);
			};

			nextImage.addEventListener('load', reveal, { once: true });
			nextImage.addEventListener('error', () => {
				nextImage.remove();
				if (pendingImage === nextImage) pendingImage = null;
				crossfading = false;
			}, { once: true });
			if (nextImage.complete && nextImage.naturalWidth > 0) reveal();
		}

		function stopCarousel() {
			if (timer !== null) {
				clearInterval(timer);
				timer = null;
			}
		}

		function clearImages() {
			if (transitionTimer !== null) {
				clearTimeout(transitionTimer);
				transitionTimer = null;
			}
			layer.replaceChildren();
			activeImage = null;
			pendingImage = null;
			currentDevice = null;
			crossfading = false;
		}

		function startCarousel() {
			stopCarousel();
			const { images } = getSourceSet();
			if (
				!carouselEnabled ||
				images.length <= 1 ||
				document.hidden ||
				window.matchMedia('(prefers-reduced-motion: reduce)').matches
			) return;
			timer = setInterval(() => {
				if (isOverlayMode()) showImage(currentIndex + 1, 'low');
			}, carouselInterval * 1000);
		}

		function syncWallpaper() {
			if (!isOverlayMode()) {
				container.style.display = 'none';
				stopCarousel();
				clearImages();
				return;
			}
			container.style.display = 'block';

			const { device, images } = getSourceSet();
			if (!images.length) return;
			if (currentDevice !== device) {
				clearImages();
				currentDevice = device;
				const storedIndex = Number(readStorage(sessionStorage, STORAGE_KEY) || 0);
				currentIndex = Number.isFinite(storedIndex) ? storedIndex % images.length : 0;
			}

			if (!activeImage) showImage(currentIndex, 'high');
			startCarousel();
		}

		function handleResize() {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(syncWallpaper, 150);
		}

		function handleVisibilityChange() {
			if (document.hidden) stopCarousel();
			else syncWallpaper();
		}

		window.addEventListener('wallpaper-mode-change', syncWallpaper);
		window.addEventListener('resize', handleResize, { passive: true });
		document.addEventListener('visibilitychange', handleVisibilityChange);

		function cleanup() {
			stopCarousel();
			clearTimeout(resizeTimer);
			clearImages();
			window.removeEventListener('wallpaper-mode-change', syncWallpaper);
			window.removeEventListener('resize', handleResize);
			document.removeEventListener('visibilitychange', handleVisibilityChange);
			delete container.dataset.lazyWallpaperReady;
			if (window.__wallpaper_cleanup === cleanup) {
				window.__wallpaper_cleanup = undefined;
			}
		}

		window.__wallpaper_cleanup = cleanup;
		syncWallpaper();
		container.dataset.lazyWallpaperReady = 'true';
	})();
</script>
