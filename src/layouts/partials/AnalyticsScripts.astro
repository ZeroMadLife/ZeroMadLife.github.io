---
/**
 * Optional privacy-sensitive analytics.
 *
 * The public knowledge blog leaves this disabled. Keeping the component
 * opt-in makes that boundary explicit if a future deployment needs metrics.
 */
interface Props {
	thirdPartyAnalytics?: {
		enable: boolean;
		clarityId?: string;
	};
}

const { thirdPartyAnalytics = { enable: false, clarityId: "" } } = Astro.props;
const clarityId = thirdPartyAnalytics.enable
	? thirdPartyAnalytics.clarityId?.trim()
	: "";
---

{clarityId && (
	<script is:inline define:vars={{ clarityId }}>
		(function () {
			const events = ["scroll", "mousemove", "keydown", "touchstart", "click"];
			let loaded = false;

			function loadClarity() {
				if (loaded) return;
				loaded = true;
				(function (c, l, a, r, i, t, y) {
					c[a] =
						c[a] ||
						function () {
							(c[a].q = c[a].q || []).push(arguments);
						};
					t = l.createElement(r);
					t.async = 1;
					t.src = "https://www.clarity.ms/tag/" + i;
					y = l.getElementsByTagName(r)[0];
					y.parentNode.insertBefore(t, y);
				})(window, document, "clarity", "script", clarityId);
				events.forEach((event) => window.removeEventListener(event, loadClarity));
			}

			events.forEach((event) =>
				window.addEventListener(event, loadClarity, { once: true, passive: true }),
			);
		})();
	</script>
)}
