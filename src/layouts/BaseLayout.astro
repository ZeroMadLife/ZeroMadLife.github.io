---
import { Moon, Sun } from '@lucide/astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = 'ZeroMadLife — Agent Engineering Notes',
  description = '记录 SAGE、AI Agent 工程、后端系统与持续成长。',
  image = '/images/sage/cover.webp',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  ['/', '首页'],
  ['/sage/', 'SAGE'],
  ['/posts/', 'Agent 工程'],
  ['/category/backend/', '后端与系统'],
  ['/growth/', '成长记录'],
  ['/about/', '关于'],
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8f5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="ZeroMadLife RSS" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const dark = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
      if (dark) document.documentElement.dataset.theme = 'dark';
    </script>
  </head>
  <body>
    <a href="#main" style="position:absolute;left:-999px;top:8px" onfocus="this.style.left='8px'">跳到正文</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/"><span class="brand-mark">~/</span>ZeroMadLife</a>
        <nav class="main-nav" aria-label="主导航">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={href === '/' ? path === '/' ? 'page' : undefined : path.startsWith(href) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <div class="header-actions">
          <button class="icon-button" id="theme-toggle" type="button" title="切换明暗主题" aria-label="切换明暗主题">
            <Sun size={16} class="sun-icon" aria-hidden="true" />
            <Moon size={16} class="moon-icon" aria-hidden="true" />
          </button>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>ZeroMadLife</strong>
          <p>构建 Agent，也记录成为 Agent 工程师的过程。</p>
        </div>
        <div class="footer-links">
          <a href="/rss.xml">RSS</a>
          <a href="/sitemap-index.xml">Sitemap</a>
          <a href="https://github.com/ZeroMadLife" rel="me">GitHub</a>
          <a href="https://sagecompanion.top">SAGE</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle');
      const sync = () => {
        const dark = root.dataset.theme === 'dark';
        document.querySelector('.sun-icon')?.toggleAttribute('hidden', !dark);
        document.querySelector('.moon-icon')?.toggleAttribute('hidden', dark);
      };
      sync();
      button?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? '' : 'dark';
        localStorage.setItem('theme', root.dataset.theme || 'light');
        sync();
      });
    </script>
  </body>
</html>
