---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const categoryLabels: Record<string, string> = { agent: 'Agent 工程', backend: '后端与系统', growth: '成长记录' };
---
<BaseLayout title={`${post.data.title} — ZeroMadLife`} description={post.data.description}>
  <header class="article-head"><div class="reading"><p class="eyebrow">{categoryLabels[post.data.category]} / Article</p><h1>{post.data.title}</h1><p class="article-dek">{post.data.description}</p><div class="article-meta"><time datetime={post.data.publishDate.toISOString()}>{fmt.format(post.data.publishDate)}</time><span>{post.data.tags.join(' · ')}</span></div></div></header>
  <article class="reading prose"><Content /></article>
  <section class="band"><div class="reading"><p class="eyebrow">Continue / 继续阅读</p><a class="command-link" href="/posts/">← 返回全部文章</a></div></section>
</BaseLayout>
