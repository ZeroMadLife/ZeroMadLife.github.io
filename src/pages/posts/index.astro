---
import PostsArchivePage from "@components/features/posts/PostsArchivePage.astro";
import {
	POSTS_ARCHIVE_PAGE_SIZE,
	getPostsByPublishedDate,
} from "@utils/content-utils";

const posts = await getPostsByPublishedDate();
const page = {
	data: posts.slice(0, POSTS_ARCHIVE_PAGE_SIZE),
	start: 0,
	end: Math.min(POSTS_ARCHIVE_PAGE_SIZE, posts.length),
	size: POSTS_ARCHIVE_PAGE_SIZE,
	total: posts.length,
	currentPage: 1,
	lastPage: Math.max(1, Math.ceil(posts.length / POSTS_ARCHIVE_PAGE_SIZE)),
	url: {
		current: "/posts/",
		prev: undefined,
		next: posts.length > POSTS_ARCHIVE_PAGE_SIZE ? "/posts/page/2/" : undefined,
		first: undefined,
		last:
			posts.length > POSTS_ARCHIVE_PAGE_SIZE
				? `/posts/page/${Math.ceil(posts.length / POSTS_ARCHIVE_PAGE_SIZE)}/`
				: undefined,
	},
};
---

<PostsArchivePage page={page} />
