---
import PostCard from "@components/features/posts/PostCard.astro";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";

const posts = await getSortedPosts();
---

<MainGridLayout title="文章" description="全部公开文章，按精选优先与发布时间排序。">
	<script>
		import("../../scripts/right-sidebar-layout.js");
	</script>
	<div class="card-base rounded-(--radius-large) px-6 sm:px-9 py-7 mb-4">
		<PageHeader title="文章" subtitle={`共 ${posts.length} 篇公开记录`} />
		<div class="flex flex-col gap-4">
			{posts.map((entry, index) => <PostCard entry={entry} style={`--i:${index};`} />)}
		</div>
	</div>
</MainGridLayout>
