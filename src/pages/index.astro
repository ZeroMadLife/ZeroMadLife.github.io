---
import { ArrowUpRight, GitBranch } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const latest = posts.slice(0, 5);
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const notes = [
  ['2026.07.24', '公开 HR Agent 第一阶段上线', '受控流式问答、真实引用与回执完成公网验证。'],
  ['2026.07.22', 'Chat Harness 2.0 收口', '统一事件、上下文、工具、审批与恢复协议，成为新会话默认 runtime。'],
  ['2026.05', 'Pico Agent 实验', '开始系统研究 Coding Agent 的长任务、恢复与结构化记忆。'],
];
---
<BaseLayout>
  <section class="intro-block">
    <div class="column">
      <h1 class="name">ZeroMadLife</h1>
      <p class="role">AI Agent Engineer · Java Backend · 福州</p>
      <p class="bio">构建 SAGE，也记录成为 Agent 工程师的过程。关注可恢复 Harness、Knowledge/RAG、Practice Engine，以及模型系统如何真正进入工程。</p>
    </div>
  </section>

  <section class="band">
    <div class="column">
      <div class="rubric">
        <div class="rubric-title"><h2>Featured work</h2><span>代表项目</span></div>
        <a class="more" href="/sage/">阅读全部 →</a>
      </div>
      <div class="featured">
        <div>
          <p class="kicker">Personal AI Learning Companion</p>
          <h3>SAGE</h3>
          <p>让目标、知识、实践与证据，在同一个可恢复的工作台里持续生长。当前处于受控公开 beta。</p>
          <div class="link-row">
            <a class="command-link primary" href="https://sagecompanion.top">在线体验 <ArrowUpRight size={15} /></a>
            <a class="command-link" href="https://github.com/ZeroMadLife/sage-agent"><GitBranch size={15} /> 源码</a>
          </div>
        </div>
        <a class="featured-thumb" href="/sage/" aria-label="查看 SAGE 详情">
          <img src="/images/sage/cover.webp" alt="SAGE 知识成长工作台界面" width="1600" height="1000" loading="lazy" />
        </a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="column">
      <div class="rubric">
        <div class="rubric-title"><h2>Latest writing</h2><span>最近写作</span></div>
        <a class="more" href="/posts/">全部文章 →</a>
      </div>
      <div class="stream">
        {latest.map((post) => (
          <a class="stream-item" href={`/posts/${post.id}/`}>
            <span class="t">{post.data.title}</span>
            <time datetime={post.data.publishDate.toISOString()}>{fmt.format(post.data.publishDate)}</time>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="column">
      <div class="rubric">
        <div class="rubric-title"><h2>Field notes</h2><span>最近动态</span></div>
        <a class="more" href="/growth/">完整时间线 →</a>
      </div>
      <div class="timeline">
        {notes.map(([date, title, text]) => (
          <div class="timeline-item"><time>{date}</time><div><h3>{title}</h3><p>{text}</p></div></div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
