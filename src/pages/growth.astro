---
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const events = [
	["2026.07.28", "SAGE RAG 取舍完成公开复盘", "冻结评测、Provider 选择、门禁与默认开关形成可追溯记录。"],
	["2026.07.25", "Agent 评测边界成型", "把 Context、Memory、RAG、Harness 的控制正确性与能力表现拆开测量。"],
	["2026.07.24", "SAGE 学习闭环公开", "Purpose、Explore、Knowledge、Practice、Evidence、Evolve 形成连续路径。"],
	["2026.07.18", "公开知识库开始运行", "把本地学习和项目复盘整理为可检索、可引用的静态文章。"],
];
---

<MainGridLayout title="成长记录" description="公开项目里程碑与学习轨迹。">
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<section class="card-base rounded-(--radius-large) px-6 sm:px-9 py-7 mb-4">
		<PageHeader title="成长记录" subtitle="过程不是花絮，它决定下一次从哪里继续。" />
		<ol class="growth-timeline">
			{events.map(([date, title, text]) => (
				<li>
					<time>{date}</time>
					<div><h2>{title}</h2><p>{text}</p></div>
				</li>
			))}
		</ol>
	</section>
</MainGridLayout>

<style>
	.growth-timeline { display: grid; gap: 0; }
	.growth-timeline li { display: grid; grid-template-columns: 7rem 1fr; gap: 1.25rem; padding: 1.25rem 0; border-top: 1px solid var(--line-divider); }
	.growth-timeline time { color: var(--primary); font-weight: 700; }
	.growth-timeline h2 { font-size: 1.05rem; font-weight: 700; margin-bottom: .35rem; }
	.growth-timeline p { color: var(--text-50); line-height: 1.75; }
	@media (max-width: 520px) { .growth-timeline li { grid-template-columns: 1fr; gap: .45rem; } }
</style>
