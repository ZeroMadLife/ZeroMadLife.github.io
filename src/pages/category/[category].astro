---
import PostCard from "@components/features/posts/PostCard.astro";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return ["agent", "backend", "growth"].map((category) => ({
		params: { category },
		props: {
			posts: posts.filter((post) =>
				category === "growth"
					? post.data.tags.some((tag) => /growth|career|成长/i.test(tag))
					: post.data.category === category,
			),
		},
	}));
}

const category = Astro.params.category ?? "";
const posts = Astro.props.posts;
const labels: Record<string, string> = {
	agent: "Agent 工程",
	backend: "后端工程",
	growth: "成长记录",
};
const title = labels[category] ?? category;
---

<MainGridLayout title={title} description={`${title}分类下的公开文章。`}>
	<script>
		import("../../scripts/right-sidebar-layout.js");
	</script>
	<div class="card-base rounded-(--radius-large) px-6 sm:px-9 py-7 mb-4">
		<PageHeader title={title} subtitle={`${posts.length} 篇文章`} />
		{
			posts.length > 0 ? (
				<div class="flex flex-col gap-4">
					{posts.map((entry: any, index: number) => (
						<PostCard entry={entry} style={`--i:${index};`} />
					))}
				</div>
			) : (
				<p class="text-black/55 dark:text-white/55 py-8">这个分类正在整理，新的公开记录会在这里出现。</p>
			)
		}
	</div>
</MainGridLayout>
